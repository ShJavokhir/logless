# Copy to .env (never commit .env). App VM / local backend.
VULTR_INFERENCE_API_KEY=
TYPESAFE_API_KEY=
FIREWORKS_API_KEY=
# Random secrets: python3 -c "import secrets;print(secrets.token_hex(32))"
PSEUDONYM_SALT=
RUNNER_TOKEN=
RUNNER_URL=http://127.0.0.1:8787
# Backend expectation: runsc by default; set runc only for an explicit local-development runner.
SANDBOX_RUNTIME=runsc
LOGLESS_DATA_DIR=./var
SAMPLE_SIZE=5000
SAMPLE_SEED=20260926
# "production" on the app VM (disables dev CORS; dev_snapshot.py refuses to run)
LOGLESS_ENV=development
# Stage demo capacity: requests with header X-Logless-Presenter=<this> use a separate budget (unset = off)
PRESENTER_KEY=
# Optional phone remote control. Production requires all three settings below and a NetBird peer on this VM.
NETBIRD_API_URL=https://api.netbird.io
NETBIRD_API_TOKEN=
NETBIRD_PEER_ID=
# Caddy serves the SPA and /api on 8080 for NetBird traffic arriving over wt0.
NETBIRD_TARGET_PORT=8080
# Optional: otherwise the first online proxy cluster is used.
NETBIRD_PROXY_DOMAIN=
# Optional local development URL, e.g. http://192.168.1.20:5173 (no PIN outside NetBird).
REMOTE_LOCAL_URL=
