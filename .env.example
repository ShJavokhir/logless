# Copy to .env (never commit .env). App VM / local backend.
# Use the subscription's inference API key, not the Vultr account API key.
VULTR_INFERENCE_API_KEY=
TYPESAFE_API_KEY=
FIREWORKS_API_KEY=
# Random secrets: python3 -c "import secrets;print(secrets.token_hex(32))"
PSEUDONYM_SALT=
RUNNER_TOKEN=
RUNNER_URL=http://127.0.0.1:8787
LOGLESS_DATA_DIR=./var
SAMPLE_SIZE=5000
SAMPLE_SEED=20260926
# "production" on the app VM (disables dev CORS; dev_snapshot.py refuses to run)
LOGLESS_ENV=development
# Stage demo capacity: requests with header X-Logless-Presenter=<this> use a separate budget (unset = off)
PRESENTER_KEY=

# Optional synthetic pipeline (operator command; separate persistence from WildChat).
# LOGLESS_DATA_DIR=./var-synthetic
# Next.js frontend API proxy; defaults to the deployed WildChat API when unset.
# LOGLESS_API_ORIGIN=http://127.0.0.1:8000
# Separate build directory for a concurrent synthetic preview on another port.
# LOGLESS_BUILD_DIR=.next-synthetic
